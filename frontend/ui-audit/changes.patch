+:root :is(input, select, textarea, .ui-control, .record-field)[aria-invalid="true"]:focus-visible { border-color: var(--danger-text); outline-color: var(--danger-text); }
+:root :is(input, select, textarea, .ui-control, .record-field)[data-state="success"] { border-color: var(--success-text); }
